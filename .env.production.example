# ==============================================================================
# CardHub - Production Environment Variables Template (.env.production.example)
# Инструкция: на боевом сервере скопируйте в .env:
# cp .env.production.example .env
# ==============================================================================

# 1. Домен сервиса (Обязательно с https://)
NEXT_PUBLIC_APP_URL="https://cardhub.ru"
NODE_ENV="production"

# 2. База данных PostgreSQL (используется контейнером cardhub-db)
POSTGRES_USER="cardhub"
POSTGRES_PASSWORD="сгенерируйте_сложный_пароль"
POSTGRES_DB="cardhub"
DATABASE_URL="postgresql://cardhub:сгенерируйте_сложный_пароль@postgres:5432/cardhub?schema=public"

# 3. Redis (используется контейнером cardhub-redis для Rate Limiting)
REDIS_URL="redis://redis:6379"

# 4. Безопасность и сессии (Сгенерируйте: openssl rand -hex 64)
SESSION_SECRET="сгенерируйте_64_байта_случайных_символов_openssl_rand_hex_64"

# 5. Шифрование 2FA TOTP ключей в БД (AES-256-GCM, сгенерируйте: openssl rand -hex 32)
ENCRYPTION_KEY="сгенерируйте_32_байта_случайных_символов_openssl_rand_hex_32"

# 6. Транзакционная почта (SMTP)
# Временный Rambler или корпоративная почта на вашем домене (Яндекс 360 / Mail.ru)
SMTP_HOST="smtp.rambler.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@cardhub.ru"
SMTP_PASS="сгенерируйте_пароль_приложения_smtp"
SMTP_FROM="CardHub <noreply@cardhub.ru>"

# 7. Платежный шлюз ЮKassa (Боевые ключи после заключения договора)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# 8. S3 Объектное хранилище (Опционально; по умолчанию используется persistent volume)
S3_ENDPOINT=""
S3_REGION="ru-central1"
S3_BUCKET="cardhub-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
