# Database configuration (PostgreSQL 16+)
DATABASE_URL="postgresql://user:password@localhost:5432/cardhub?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session & Security (generate 32+ byte hex key)
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-string"
NODE_ENV="development"

# Redis (optional for local dev, used for BullMQ and distributed rate-limiting)
REDIS_URL="redis://localhost:6379"

# YooKassa (payments stage 4)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# S3 File Storage (Stage 2)
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="cardhub-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Email SMTP (Russian transactional mail provider)
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CardHub <no-reply@example.com>"
