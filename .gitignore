# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc & OS
.DS_Store
Thumbs.db
Desktop.ini

# ssl & keys
*.pem
*.crt
*.key
*.csr
*.pfx
*.p12
/nginx/ssl/*
!/nginx/ssl/.gitkeep

# ide & editors
.idea/
.vscode/
*.swp
*.swo

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user uploads
/public/uploads/*
!/public/uploads/.gitkeep

# database backups
/backups/*
!/backups/.gitkeep

# certbot certificates
/nginx/certbot/conf/*
!/nginx/certbot/conf/.gitkeep
/nginx/certbot/www/*
!/nginx/certbot/www/.gitkeep

